{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iori-nav",
  "compatibility_date": "2026-04-16",
  "main": "./dist/worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "NAV_AUTH"
    }
  ],
  "d1_databases": [
    {
      "binding": "NAV_DB",
      "database_name": "book"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENABLE_PUBLIC_SUBMISSION": "false",
    "AI_REQUEST_DELAY": "500"
  }
}
